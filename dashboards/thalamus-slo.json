              "open": false
            }
          },
          "items": [
            { "x": 0, "y": 0, "width": 24, "height": 18, "content": { "$ref": "#/spec/panels/readme" } }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "items": [
            { "x": 0,  "y": 0,  "width": 6, "height": 10, "content": { "$ref": "#/spec/panels/ttft_p50" } },
            { "x": 6,  "y": 0,  "width": 6, "height": 10, "content": { "$ref": "#/spec/panels/ttft_p99" } },
            { "x": 12, "y": 0,  "width": 6, "height": 10, "content": { "$ref": "#/spec/panels/tpot_p50" } },
            { "x": 18, "y": 0,  "width": 6, "height": 10, "content": { "$ref": "#/spec/panels/tpot_p99" } },
            { "x": 0,  "y": 13, "width": 6, "height": 10, "content": { "$ref": "#/spec/panels/e2e_p50" } },
            { "x": 6,  "y": 13, "width": 6, "height": 10, "content": { "$ref": "#/spec/panels/e2e_p99" } },
            { "x": 12, "y": 13, "width": 6, "height": 10, "content": { "$ref": "#/spec/panels/itl_p50" } },
            { "x": 18, "y": 13, "width": 6, "height": 10, "content": { "$ref": "#/spec/panels/itl_p99" } },
            { "x": 0,  "y": 26, "width": 8, "height": 7, "content": { "$ref": "#/spec/panels/queue_depth" } },
            { "x": 8,  "y": 26, "width": 8, "height": 7, "content": { "$ref": "#/spec/panels/ready_endpoints" } },
            { "x": 16, "y": 26, "width": 8, "height": 7, "content": { "$ref": "#/spec/panels/time_to_ready" } }
          ]
        }
      }
    ],
    "duration": "1h",
    "refreshInterval": "30s"
  }
