            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": { "kind": "PrometheusDatasource", "name": "kube-monitoring-prometheus" },
                    "query": "round(histogram_quantile($quantile, sum by (model_name, le) (rate(vllm:request_params_n_bucket[$rate_interval]))))",
                    "seriesNameFormat": "{{model_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "requested_max_tokens": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Requested max_tokens"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
