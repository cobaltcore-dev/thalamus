                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 2
              },
              "yAxis": {
                "format": { "unit": "decimal", "shortValues": true },
                "label": "tokens",
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": { "kind": "PrometheusDatasource", "name": "kube-monitoring-prometheus" },
                    "query": "round(histogram_quantile($quantile, sum by (le) (rate(llm_d_epp_request_input_tokens_bucket[$rate_interval]))))",
                    "seriesNameFormat": "all"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": { "kind": "PrometheusDatasource", "name": "kube-monitoring-prometheus" },
                    "query": "round(histogram_quantile($quantile, sum by (target_model_name, le) (rate(llm_d_epp_request_input_tokens_bucket[$rate_interval]))))",
                    "seriesNameFormat": "{{target_model_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "output_tokens_dist": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Output Tokens"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": ["last"]
              },
              "visual": {
                "areaOpacity": 0.1,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 2
              },
              "yAxis": {
                "format": { "unit": "decimal", "shortValues": true },
                "label": "tokens",
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": { "kind": "PrometheusDatasource", "name": "kube-monitoring-prometheus" },
                    "query": "round(histogram_quantile($quantile, sum by (le) (rate(llm_d_epp_request_output_tokens_bucket[$rate_interval]))))",
                    "seriesNameFormat": "all"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": { "kind": "PrometheusDatasource", "name": "kube-monitoring-prometheus" },
                    "query": "round(histogram_quantile($quantile, sum by (target_model_name, le) (rate(llm_d_epp_request_output_tokens_bucket[$rate_interval]))))",
                    "seriesNameFormat": "{{target_model_name}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "README",
            "collapse": { "open": false }
          },
          "items": [
            { "x": 0, "y": 0, "width": 24, "height": 18, "content": { "$ref": "#/spec/panels/readme" } }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Tokens",
            "collapse": { "open": true }
          },
          "items": [
            { "x": 0,  "y": 0, "width": 8,  "height": 8, "content": { "$ref": "#/spec/panels/prompt_tokens" } },
            { "x": 8,  "y": 0, "width": 8,  "height": 8, "content": { "$ref": "#/spec/panels/prompt_tokens_by_source" } },
            { "x": 16, "y": 0, "width": 8,  "height": 8, "content": { "$ref": "#/spec/panels/generation_tokens" } },
            { "x": 0,  "y": 8, "width": 8,  "height": 8, "content": { "$ref": "#/spec/panels/input_tokens_dist" } },
            { "x": 8,  "y": 8, "width": 8,  "height": 8, "content": { "$ref": "#/spec/panels/output_tokens_dist" } },
            { "x": 16, "y": 8, "width": 8,  "height": 8, "content": { "$ref": "#/spec/panels/generation_tokens_total" } }
