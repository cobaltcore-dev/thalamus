              "yAxis": {
                "format": { "unit": "decimal", "shortValues": true },
                "label": "tokens",
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": { "kind": "PrometheusDatasource", "name": "kube-monitoring-prometheus" },
                    "query": "round(histogram_quantile($quantile, sum by (le) (rate(vllm:request_params_max_tokens_bucket[$rate_interval]))))",
                    "seriesNameFormat": "all"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": { "kind": "PrometheusDatasource", "name": "kube-monitoring-prometheus" },
                    "query": "round(histogram_quantile($quantile, sum by (model_name, le) (rate(vllm:request_params_max_tokens_bucket[$rate_interval]))))",
                    "seriesNameFormat": "{{model_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "outcomes_breakdown": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Request Outcomes"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": ["last"]
              },
              "visual": {
                "areaOpacity": 0.7,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 0
              },
              "yAxis": {
                "format": { "unit": "decimal" },
                "label": "req/s",
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
