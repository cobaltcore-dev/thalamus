    "panels": {
      "success_rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Success Rate (per model)"
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last"
                ]
              },
              "visual": {
                "areaOpacity": 0.2,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal"
                },
                "label": "req/h",
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (model_name) (rate(vllm:request_success_total{finished_reason=~\"stop|length\"}[$rate_interval])) * 3600",
                    "seriesNameFormat": "{{model_name}}"
                  }
                }
              }
            }
