      "generation_tokens_total": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Total Tokens Generated",
            "description": "Total amount of generated tokens in the selected range."
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "density": "compact",
              "defaultColumnHidden": true,
              "columnSettings": [
                {
                  "name": "model_name",
                  "header": "Model",
                  "hide": false
                },
                {
                  "name": "value",
                  "header": "Tokens",
                  "hide": false,
                  "align": "right",
                  "format": {
                    "unit": "decimal",
                    "shortValues": true
                  }
                },
                {
                  "name": "timestamp",
                  "hide": true
                }
              ],
              "transforms": [
                {
                  "kind": "MergeSeries",
                  "spec": {}
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "round(sum by (model_name) (increase(vllm:generation_tokens_total[$__range]))) or label_replace(round(sum(increase(vllm:generation_tokens_total[$__range]))), \"model_name\", \"Total\", \"\", \"\")",
                    "seriesNameFormat": "{{model_name}}"
                  }
                }
              }
            }
          ]
        }
