      "container_fs_reads": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Container FS Reads",
            "description": "Filesystem read rate per model. Sustained reads during inference mean weights are paging from disk."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last"
                ]
              },
              "visual": {
                "areaOpacity": 0.2,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 2
              },
              "yAxis": {
                "format": {
                  "unit": "bytes"
                },
                "min": 0,
                "show": true,
                "label": "B/s"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (model) (label_replace(rate(container_fs_reads_bytes_total{container=\"vllm\"}[$rate_interval]), \"model\", \"$1\", \"pod\", \"(vllm-.+)-[a-z0-9]{10}-[a-z0-9]{5}$\")) * $rate_multiplier",
                    "seriesNameFormat": "{{model}}"
                  }
                }
              }
            }
          ]
        }
      },
