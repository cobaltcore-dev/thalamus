{
  "kind": "Dashboard",
  "metadata": {
    "name": "thalamus_gpu",
    "project": "thalamus"
  },
  "spec": {
    "display": {
      "name": "Thalamus GPU"
    },
    "variables": [
      {
        "kind": "TextVariable",
        "spec": {
          "display": {
            "name": "Rate Interval",
            "hidden": false
          },
          "value": "15m",
          "name": "rate_interval"
        }
      }
    ],
    "panels": {
      "readme": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "README"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "# Thalamus GPU\n\nHardware view of the GPUs backing vLLM in `thalamus` — is the GPU busy (and busy doing what?), and is it healthy? Metrics come from DCGM (NVIDIA's exporter), which has no `model_name` label; one pod hosts one model in this cluster, so per-pod grouping is effectively per-model.\n\nUtilization panels show ratios (0-1): `0.85` means the counter was active for 85% of the sampling window.\n\n## Variables\n\n- `rate_interval` controls the smoothing window for counter rates. Shorter windows expose bursts, longer windows smooth sparse traffic."
            }
          }
        }
      },
      "vram_utilization": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "VRAM Utilization",
            "description": "Fraction of GPU memory occupied; a sudden step means a new model was loaded."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last"
                ]
              },
              "visual": {
                "areaOpacity": 0.1,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 2
              },
              "yAxis": {
                "format": {
                  "unit": "percent-decimal"
                },
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "avg by (exported_pod) (DCGM_FI_DEV_FB_USED / (DCGM_FI_DEV_FB_USED + DCGM_FI_DEV_FB_FREE))",
                    "seriesNameFormat": "{{exported_pod}}"
                  }
                }
              }
            }
          ]
        }
      },
      "dram_active": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HBM Activity",
            "description": "Fraction of cycles HBM was active. High with low compute occupancy means memory-bound."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last"
                ]
              },
              "visual": {
                "areaOpacity": 0.1,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 2
              },
              "yAxis": {
                "format": {
                  "unit": "percent-decimal"
                },
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "avg by (exported_pod) (DCGM_FI_PROF_DRAM_ACTIVE)",
                    "seriesNameFormat": "{{exported_pod}}"
                  }
                }
              }
            }
          ]
        }
      },
      "gr_engine_active": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Compute Occupancy",
            "description": "Fraction of cycles the compute engine was working. Low under load means stalling."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last"
                ]
              },
              "visual": {
                "areaOpacity": 0.1,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 2
              },
              "yAxis": {
                "format": {
                  "unit": "percent-decimal"
                },
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "avg by (exported_pod) (DCGM_FI_PROF_GR_ENGINE_ACTIVE)",
                    "seriesNameFormat": "{{exported_pod}}"
                  }
                }
              }
            }
          ]
        }
      },
      "tensor_active": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Tensor Core Utilization",
            "description": "Fraction of cycles tensor cores were working. Near zero points to a non-tensor-core code path."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last"
                ]
              },
              "visual": {
                "areaOpacity": 0.1,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 2
              },
              "yAxis": {
                "format": {
                  "unit": "percent-decimal"
                },
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "avg by (exported_pod) (DCGM_FI_PROF_PIPE_TENSOR_ACTIVE)",
                    "seriesNameFormat": "{{exported_pod}}"
                  }
                }
              }
            }
          ]
        }
      },
      "gpu_temp": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "GPU Temperature",
            "description": "GPU die temperature. Sustained readings above ~90°C indicate thermal throttling."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last"
                ]
              },
              "visual": {
                "areaOpacity": 0.1,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 2
              },
              "yAxis": {
                "format": {
                  "unit": "celsius"
                },
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "avg by (exported_pod) (DCGM_FI_DEV_GPU_TEMP)",
                    "seriesNameFormat": "{{exported_pod}}"
                  }
                }
              }
            }
          ]
        }
      },
      "pcie_bandwidth": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "PCIe Bandwidth",
            "description": "Total host-to-device PCIe traffic. Sustained traffic during inference means weights are paging from the host."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "table",
                "position": "right",
                "size": "small",
                "values": [
                  "last"
                ]
              },
              "visual": {
                "areaOpacity": 0.1,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 2
              },
              "yAxis": {
                "format": {
                  "unit": "bytes/sec",
                  "shortValues": true
                },
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (exported_pod) (rate(DCGM_FI_PROF_PCIE_RX_BYTES[$rate_interval]) + rate(DCGM_FI_PROF_PCIE_TX_BYTES[$rate_interval]))",
                    "seriesNameFormat": "{{exported_pod}}"
                  }
                }
              }
            }
          ]
        }
      },
      "hardware_health": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Hardware Health",
            "description": "PCIe replays, ECC remapped rows, and remap failures per pod. All values should be zero."
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "density": "compact",
              "defaultColumnHidden": true,
              "columnSettings": [
                {
                  "name": "exported_pod",
                  "header": "Pod",
                  "hide": false
                },
                {
                  "name": "value #1",
                  "header": "PCIe Replays",
                  "hide": false,
                  "align": "right",
                  "format": {
                    "unit": "decimal"
                  },
                  "width": 40
                },
                {
                  "name": "value #2",
                  "header": "ECC Rows",
                  "hide": false,
                  "align": "right",
                  "format": {
                    "unit": "decimal"
                  },
                  "width": 40
                },
                {
                  "name": "value #3",
                  "header": "Remap Failure",
                  "hide": false,
                  "align": "right",
                  "format": {
                    "unit": "decimal"
                  },
                  "width": 40
                },
                {
                  "name": "timestamp",
                  "hide": true
                }
              ],
              "transforms": [
                {
                  "kind": "MergeSeries",
                  "spec": {}
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (exported_pod) (DCGM_FI_DEV_PCIE_REPLAY_COUNTER)",
                    "seriesNameFormat": "replays - {{exported_pod}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (exported_pod) (DCGM_FI_DEV_UNCORRECTABLE_REMAPPED_ROWS)",
                    "seriesNameFormat": "ecc_rows - {{exported_pod}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (exported_pod) (DCGM_FI_DEV_ROW_REMAP_FAILURE)",
                    "seriesNameFormat": "remap_failure - {{exported_pod}}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "README",
            "collapse": {
              "open": false
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/readme"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/vram_utilization"
              }
            },
            {
              "x": 12,
              "y": 0,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/dram_active"
              }
            },
            {
              "x": 0,
              "y": 10,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/gr_engine_active"
              }
            },
            {
              "x": 12,
              "y": 10,
              "width": 12,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/tensor_active"
              }
            },
            {
              "x": 0,
              "y": 20,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/pcie_bandwidth"
              }
            },
            {
              "x": 8,
              "y": 20,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/gpu_temp"
              }
            },
            {
              "x": 16,
              "y": 20,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/hardware_health"
              }
            }
          ]
        }
      }
    ],
    "duration": "1h",
    "refreshInterval": "30s"
  }
}