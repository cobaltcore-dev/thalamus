      "queue_depth": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Queue Depth",
            "description": "Requests waiting in the vLLM scheduler; a leading indicator of TTFT breaches."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "mode": "list",
                "position": "bottom"
              },
              "visual": {
                "areaOpacity": 0.2,
                "connectNulls": false,
                "display": "line",
                "lineStyle": "solid",
                "lineWidth": 1.5,
                "pointRadius": 2
              },
              "yAxis": {
                "format": {
                  "unit": "decimal"
                },
                "label": "count",
                "min": 0,
                "show": true
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "sum by (model_name) (vllm:num_requests_waiting)",
                    "seriesNameFormat": "{{model_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "ready_endpoints": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Ready Endpoints",
            "description": "Endpoints the endpoint picker (EPP) considers ready, per pool."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
