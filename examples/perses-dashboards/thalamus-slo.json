      "time_to_ready": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Time to Ready",
            "description": "Seconds from pod creation to Ready, per vLLM pod."
          },
          "plugin": {
            "kind": "Table",
            "spec": {
              "density": "compact",
              "defaultColumnHidden": true,
              "columnSettings": [
                {
                  "name": "pod",
                  "header": "Pod",
                  "hide": false
                },
                {
                  "name": "value",
                  "header": "Startup (s)",
                  "hide": false,
                  "align": "right",
                  "format": {
                    "unit": "seconds"
                  }
                },
                {
                  "name": "timestamp",
                  "hide": true
                }
              ],
              "transforms": [
                {
                  "kind": "MergeSeries",
                  "spec": {}
                }
              ]
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "datasource": {
                      "kind": "PrometheusDatasource"
                    },
                    "query": "kube_pod_status_ready_time{namespace=\"thalamus\", pod=~\".*engine-.*\"} - kube_pod_created{namespace=\"thalamus\", pod=~\".*engine-.*\"}",
                    "seriesNameFormat": "{{pod}}"
                  }
                }
              }
            }
          ]
        }
      }
