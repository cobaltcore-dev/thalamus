repositories:
  - name: open-webui
    url: https://helm.openwebui.com/

releases:
  - name: gateway-api-crds
    namespace: default
    chart: ./gateway-api

  - name: gateway-api-inference-extension-crds
    namespace: default
    chart: ./gateway-api-inference-extension

  - name: node-feature-discovery
    namespace: node-feature-discovery
    createNamespace: true
    chart: oci://registry.k8s.io/nfd/charts/node-feature-discovery
    version: "0.19.0"
    installed: {{ dig "node-feature-discovery" "enabled" true .Values }}
    values:
      - {{ dig "node-feature-discovery" dict .Values | toYaml | nindent 10 }}

  - name: gpu-operator
    namespace: gpu-operator
    createNamespace: true
    chart: oci://nvcr.io/nvidia/cloud-native-charts/gpu-operator
    version: "v26.7.0"
    installed: {{ dig "gpu-operator" "enabled" true .Values }}
    needs:
      - node-feature-discovery/node-feature-discovery
    values:
      - nfd:
          enabled: false
      - {{ dig "gpu-operator" dict .Values | toYaml | nindent 10 }}

  - name: kube-prometheus-stack
    namespace: monitoring
    createNamespace: true
    chart: oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack
    version: "88.6.5"
    installed: {{ dig "kube-prometheus-stack" "enabled" true .Values }}
    values:
      - nodeExporter:
          enabled: false
        grafana:
          enabled: false
      - {{ dig "kube-prometheus-stack" dict .Values | toYaml | nindent 10 }}

  - name: agentgateway-crds
    namespace: agentgateway-system
    createNamespace: true
    chart: oci://cr.agentgateway.dev/charts/agentgateway-crds
    version: "v1.5.0"
    installed: {{ dig "agentgateway-crds" "enabled" true .Values }}
    values:
      - {{ dig "agentgateway-crds" dict .Values | toYaml | nindent 10 }}

  - name: agentgateway
    namespace: agentgateway-system
    chart: oci://cr.agentgateway.dev/charts/agentgateway
    version: "v1.5.0"
    installed: {{ dig "agentgateway" "enabled" true .Values }}
    needs:
      - default/gateway-api-crds
      - default/gateway-api-inference-extension-crds
      - agentgateway-system/agentgateway-crds
    values:
      - inferenceExtension:
          enabled: true
      - {{ dig "agentgateway" dict .Values | toYaml | nindent 10 }}

  - name: lws
    namespace: lws-system
    createNamespace: true
    chart: oci://registry.k8s.io/lws/charts/lws
    version: "0.10.0"
    installed: {{ dig "lws" "enabled" false .Values }}
    values:
      - {{ dig "lws" dict .Values | toYaml | nindent 10 }}

  - name: open-webui
    namespace: open-webui
    createNamespace: true
    chart: open-webui/open-webui
    version: "16.1.0"
    installed: {{ dig "open-webui" "enabled" true .Values }}
    needs:
      - thalamus/thalamus
    values:
      - ollama:
          enabled: false
        pipelines:
          enabled: false
        tika:
          enabled: false
        terminals:
          enabled: false
        extraEnvVars:
          - name: WEBUI_AUTH
            value: "False"
        service:
          type: ClusterIP
        openaiBaseApiUrl: "http://inference-gateway.thalamus.svc.cluster.local/v1"
        route:
          enabled: true
          parentRefs:
            - name: inference-gateway
              namespace: thalamus
              sectionName: frontend
      - {{ dig "open-webui" dict .Values | toYaml | nindent 10 }}

  - name: thalamus-crds
    namespace: thalamus
    createNamespace: true
    chart: ./thalamus-crds

  - name: thalamus
    chart: ./thalamus
    namespace: thalamus
    createNamespace: true
    needs:
      - thalamus/thalamus-crds
      - agentgateway-system/agentgateway
    values:
      {{- if (dig "open-webui" "enabled" true .Values) }}
      - gateway:
          listeners:
            frontend:
              port: 8080
              protocol: HTTP
              allowedRoutes:
                namespaces:
                  from: All
      {{- end }}
      - {{ dig "thalamus" dict .Values | toYaml | nindent 10 }}
