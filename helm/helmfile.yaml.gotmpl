repositories:
  - name: nvidia
    url: https://helm.ngc.nvidia.com/nvidia
  - name: open-webui
    url: https://helm.openwebui.com/

releases:
  - name: gateway-api-crds
    namespace: default
    chart: ./gateway-api

  - name: gateway-api-inference-extension-crds
    namespace: default
    chart: ./gateway-api-inference-extension

  - name: node-feature-discovery
    namespace: node-feature-discovery
    createNamespace: true
    chart: oci://registry.k8s.io/nfd/charts/node-feature-discovery
    version: "0.18.3"
    installed: {{ dig "node-feature-discovery" "enabled" true .Values }}
    values:
      - {{ dig "node-feature-discovery" dict .Values | toYaml | nindent 10 }}

  - name: gpu-operator
    namespace: gpu-operator
    createNamespace: true
    chart: nvidia/gpu-operator
    version: "v26.3.3"
    installed: {{ dig "gpu-operator" "enabled" true .Values }}
    needs:
      - node-feature-discovery/node-feature-discovery
    values:
      - nfd:
          enabled: false
      - {{ dig "gpu-operator" dict .Values | toYaml | nindent 10 }}

  - name: kube-prometheus-stack
    namespace: monitoring
    createNamespace: true
    chart: oci://ghcr.io/prometheus-community/charts/kube-prometheus-stack
    version: "87.5.1"
    installed: {{ dig "kube-prometheus-stack" "enabled" true .Values }}
    values:
      - nodeExporter:
          enabled: false
        grafana:
          enabled: false
      - {{ dig "kube-prometheus-stack" dict .Values | toYaml | nindent 10 }}

  - name: agentgateway-crds
    namespace: agentgateway-system
    createNamespace: true
    chart: oci://cr.agentgateway.dev/charts/agentgateway-crds
    version: "v1.3.1"
    installed: {{ dig "agentgateway-crds" "enabled" true .Values }}
    values:
      - {{ dig "agentgateway-crds" dict .Values | toYaml | nindent 10 }}

  - name: agentgateway
    namespace: agentgateway-system
    chart: oci://cr.agentgateway.dev/charts/agentgateway
    version: "v1.3.1"
    installed: {{ dig "agentgateway" "enabled" true .Values }}
    needs:
      - default/gateway-api-crds
      - default/gateway-api-inference-extension-crds
      - agentgateway-system/agentgateway-crds
    values:
      - inferenceExtension:
          enabled: true
      - {{ dig "agentgateway" dict .Values | toYaml | nindent 10 }}

  - name: cert-manager
    namespace: cert-manager
    createNamespace: true
    chart: oci://quay.io/jetstack/charts/cert-manager
    version: "v1.20.3"
    installed: {{ dig "cert-manager" "enabled" true .Values }}
    values:
      - crds:
          enabled: true

  - name: kserve-llmisvc-crd
    namespace: kserve
    createNamespace: true
    chart: oci://ghcr.io/kserve/charts/kserve-llmisvc-crd
    version: "v0.19.0"
    installed: {{ dig "kserve-llmisvc-crd" "enabled" true .Values }}

  - name: kserve-llmisvc-resources
    namespace: kserve
    chart: oci://ghcr.io/kserve/charts/kserve-llmisvc-resources
    version: "v0.19.0"
    installed: {{ dig "kserve-llmisvc-resources" "enabled" true .Values }}
    needs:
      - agentgateway-system/agentgateway
      - cert-manager/cert-manager
      - kserve/kserve-llmisvc-crd
      - thalamus/thalamus  # install controller after thalamus, to avoid webhook timeouts
    values:
      - kserve:
          llmisvc:
            createGIECRDs: false  # https://github.com/kserve/kserve/issues/5543#issuecomment-4875485608
          storage:
            resources:
              requests:
                cpu: "1"
                memory: 1Gi
              limits:
                cpu: "4"
                memory: 16Gi

  - name: kserve-runtime-configs
    namespace: kserve
    chart: oci://ghcr.io/kserve/charts/kserve-runtime-configs
    version: "v0.19.0"
    installed: {{ dig "kserve-runtime-configs" "enabled" true .Values }}
    needs:
      - kserve/kserve-llmisvc-crd
    values:
      - kserve:
          llmisvcConfigs:
            enabled: true

  - name: open-webui
    namespace: open-webui
    createNamespace: true
    chart: open-webui/open-webui
    version: "15.2.0"
    installed: {{ dig "open-webui" "enabled" true .Values }}
    needs:
      - thalamus/thalamus
    values:
      - ollama:
          enabled: false
        pipelines:
          enabled: false
        tika:
          enabled: false
        terminals:
          enabled: false
        extraEnvVars:
          - name: WEBUI_AUTH
            value: "False"
        service:
          type: ClusterIP
        openaiBaseApiUrl: "http://inference-gateway.thalamus.svc.cluster.local/v1"
        route:
          enabled: true
          parentRefs:
            - name: inference-gateway
              namespace: thalamus
      - {{ dig "open-webui" dict .Values | toYaml | nindent 10 }}

  - name: thalamus-crds
    namespace: thalamus
    createNamespace: true
    chart: ./thalamus-crds

  - name: thalamus
    chart: ./thalamus
    namespace: thalamus
    createNamespace: true
    needs:
      - thalamus/thalamus-crds
      - agentgateway-system/agentgateway
      - kserve/kserve-llmisvc-crd
    values:
      - {{ dig "thalamus" dict .Values | toYaml | nindent 10 }}
