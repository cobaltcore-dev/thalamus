# Dev convenience only; no official install method (see website/getting-started.md)

releases:
  - name: gateway-api-crds
    namespace: default
    chart: ../helm/gateway-api

  - name: gateway-api-inference-extension-crds
    namespace: default
    chart: ../helm/gateway-api-inference-extension

  - name: agentgateway-crds
    namespace: agentgateway-system
    createNamespace: true
    chart: oci://cr.agentgateway.dev/charts/agentgateway-crds
    version: "v1.5.0"
    installed: {{ dig "agentgateway-crds" "enabled" true .Values }}
    values:
      - {{ dig "agentgateway-crds" dict .Values | toYaml | nindent 10 }}

  - name: agentgateway
    namespace: agentgateway-system
    chart: oci://cr.agentgateway.dev/charts/agentgateway
    version: "v1.5.0"
    installed: {{ dig "agentgateway" "enabled" true .Values }}
    needs:
      - default/gateway-api-crds
      - default/gateway-api-inference-extension-crds
      - agentgateway-system/agentgateway-crds
    values:
      - inferenceExtension:
          enabled: true
      - {{ dig "agentgateway" dict .Values | toYaml | nindent 10 }}

  - name: open-webui
    namespace: open-webui
    createNamespace: true
    chart: oci://ghcr.io/open-webui/helm-charts/open-webui
    version: "16.5.0"
    installed: {{ dig "open-webui" "enabled" true .Values }}
    needs:
      - thalamus/thalamus
    values:
      - ollama:
          enabled: false
        pipelines:
          enabled: false
        extraEnvVars:
          - name: WEBUI_AUTH
            value: "False"
        openaiBaseApiUrl: "http://inference-gateway.thalamus.svc.cluster.local/v1"
        route:
          enabled: true
          parentRefs:
            - name: inference-gateway
              namespace: thalamus
              sectionName: frontend
      - {{ dig "open-webui" dict .Values | toYaml | nindent 10 }}

  - name: thalamus-crds
    namespace: thalamus
    createNamespace: true
    chart: ../helm/thalamus-crds
    values:
      - gateway-api:
          enabled: false
        gateway-api-inference-extension:
          enabled: false
        agentgateway-crds:
          enabled: false
      - {{ dig "thalamus-crds" dict .Values | toYaml | nindent 10 }}


  - name: thalamus
    chart: ../helm/thalamus
    namespace: thalamus
    createNamespace: true
    needs:
      - thalamus/thalamus-crds
      - agentgateway-system/agentgateway
    values:
      - agentgateway:
          enabled: false
      {{- if (dig "open-webui" "enabled" true .Values) }}
      - gateway:
          listeners:
            frontend:
              port: 8080
              protocol: HTTP
              allowedRoutes:
                namespaces:
                  from: All
      {{- end }}
      - {{ dig "thalamus" dict .Values | toYaml | nindent 10 }}
